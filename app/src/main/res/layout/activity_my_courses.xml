<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/myCoursesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header Background -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:background="@color/primary_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Back Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackMyCourses"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:padding="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_back"
        app:iconSize="20dp"
        app:iconTint="#0F172A"
        app:backgroundTint="#FFFFFF"
        app:strokeColor="#E5E7EB"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tvMyCoursesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="74dp"
        android:text="My Courses"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="18dp"
        android:text="Continue learning from your saved course bucket."
        android:textColor="#DCE7FF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMyCoursesTitle"/>

    <!-- Search Bar -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="16dp"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#FFFFFF"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:startIconTint="#64748B"
        app:hintTextColor="#94A3B8"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search your courses"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Scroll content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMyCourses"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tilSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentMyCourses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp"
            android:paddingTop="6dp">

            <!-- ========= CARD TEMPLATE (reuse the same style) ========= -->

            <!-- Graphic Design -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGraphicDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#EEF2F7"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <!-- Icon -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconGD"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#EEF2FF"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="GD"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/primary_blue"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvTitleGD"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Graphic Designing"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconGD"
                        app:layout_constraintTop_toTopOf="@id/iconGD"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenGD"/>

                    <TextView
                        android:id="@+id/tvMetaGD"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="3dp"
                        android:text="4.8 • 12h • Beginner"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/iconGD"
                        app:layout_constraintTop_toBottomOf="@id/tvTitleGD"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenGD"/>

                    <!-- Progress label -->
                    <TextView
                        android:id="@+id/tvProgressGD"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress 60%"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/iconGD"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <!-- Progress bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressGD"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:progress="60"
                        app:trackCornerRadius="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tvProgressGD"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenGD"/>

                    <!-- Open button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenGD"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:text="Open"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="@color/primary_blue"
                        app:cornerRadius="14dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wireframing -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWireframing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#EEF2F7"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconWF"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#ECFDF3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="WF"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#15803D"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvTitleWF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Wireframing"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconWF"
                        app:layout_constraintTop_toTopOf="@id/iconWF"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenWF"/>

                    <TextView
                        android:id="@+id/tvMetaWF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="3dp"
                        android:text="4.8 • 6h • Beginner"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/iconWF"
                        app:layout_constraintTop_toBottomOf="@id/tvTitleWF"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenWF"/>

                    <TextView
                        android:id="@+id/tvProgressWF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress 30%"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/iconWF"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressWF"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:progress="30"
                        app:trackCornerRadius="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tvProgressWF"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenWF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenWF"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:text="Open"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="@color/primary_blue"
                        app:cornerRadius="14dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Website Design -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWebsiteDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#EEF2F7"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconWD"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#EFF6FF"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="WD"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/primary_blue"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvTitleWD"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Website Design"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconWD"
                        app:layout_constraintTop_toTopOf="@id/iconWD"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenWD"/>

                    <TextView
                        android:id="@+id/tvMetaWD"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="3dp"
                        android:text="4.9 • 10h • Intermediate"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/iconWD"
                        app:layout_constraintTop_toBottomOf="@id/tvTitleWD"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenWD"/>

                    <TextView
                        android:id="@+id/tvProgressWD"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress 80%"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/iconWD"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressWD"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:progress="80"
                        app:trackCornerRadius="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tvProgressWD"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenWD"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenWD"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:text="Open"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="@color/primary_blue"
                        app:cornerRadius="14dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Video Editing -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVideoEditing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#EEF2F7"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconVE"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#FEF3C7"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="VE"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#92400E"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvTitleVE"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Video Editing"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconVE"
                        app:layout_constraintTop_toTopOf="@id/iconVE"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenVE"/>

                    <TextView
                        android:id="@+id/tvMetaVE"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="3dp"
                        android:text="4.7 • 14h • Intermediate"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/iconVE"
                        app:layout_constraintTop_toBottomOf="@id/tvTitleVE"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenVE"/>

                    <TextView
                        android:id="@+id/tvProgressVE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress 10%"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/iconVE"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressVE"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:progress="10"
                        app:trackCornerRadius="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tvProgressVE"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnOpenVE"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenVE"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:text="Open"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="@color/primary_blue"
                        app:cornerRadius="14dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
